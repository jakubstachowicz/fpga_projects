; reset vector
ADDRESS 000
    JUMP entrypoint

; przyjete ABI: 
;     s0-s3 - gwarancja zachowania stanu rejestrow przy wywolaniu funkcji

variables_in_mem:
    ; little endian
    ; pierwsze 16 bajtow zajmuje tablica translacji bajt -> 7seg display
    CONSTANT clock_ms_count_b0, 10  ; pozycja czterech bajtow licznika
    CONSTANT clock_ms_count_b1, 11
    CONSTANT clock_ms_count_b2, 12
    CONSTANT clock_ms_count_b3, 13
    CONSTANT debounce_cntr_0, 14  ; tablica[] licznikow debounce
    CONSTANT debounce_cntr_1, 15
    CONSTANT debounce_cntr_2, 16
    CONSTANT debounce_cntr_3, 17
    CONSTANT debounce_cntr_4, 18 ; GUARD tablicy -> nie adres komorki!!
    CONSTANT button_press_0, 18  ; tablica[] flag button press, 0-1
    CONSTANT button_press_1, 19
    CONSTANT button_press_2, 1A
    CONSTANT button_press_3, 1B
    CONSTANT edit_mode, 1C   ; flaga w jakim stanie jest maszyna stanow, 0-1
    CONSTANT cursor_select, 1D  ; wybrany segment do edycji, 0-3
    CONSTANT display_bin_val_0, 1E  ; tablica[] binarnie co sie wyswietla
    CONSTANT display_bin_val_1, 1F  
    CONSTANT display_bin_val_2, 20  
    CONSTANT display_bin_val_3, 21
    CONSTANT cursor_flash_cntr_b0, 22  ; 2-bajtowy licznik do przeflashowania cursora w edit mode
    CONSTANT cursor_flash_cntr_b1, 23  
    CONSTANT switch_mode_cntr_b0, 24  ;  2-bajtowy licznik do zmiany stanu
    CONSTANT switch_mode_cntr_b1, 25
    CONSTANT pressed_before_0, 26  ; tablica pressed before. jesli jest 1 to znaczy ze kontynuujemy stare naduszenie guzika
    CONSTANT pressed_before_1, 27
    CONSTANT pressed_before_2, 28
    CONSTANT pressed_before_3, 29

; increments counter from the beginning
increment_general_counter:
    FETCH s8, clock_ms_count_b0
    FETCH s9, clock_ms_count_b1
    FETCH sA, clock_ms_count_b2
    FETCH sB, clock_ms_count_b3
    ADD s8, 01
    ADDCY s9, 00
    ADDCY sA, 00
    ADDCY sB, 00
    STORE s8, clock_ms_count_b0
    STORE s9, clock_ms_count_b1
    STORE sA, clock_ms_count_b2
    STORE sB, clock_ms_count_b3
    RETURN

; prints data to 7 seg display considering the edit-mode flashing
print_to_7seg:
    ; najpierw wypychamy zawartosc, a dopiero potem ewentualnie sprawdzamy
    ; czy ktorys trzeba "flashnac"
    output_real_values:
        FETCH sA, display_bin_val_0
        FETCH sA, (sA)  ; translacja na znak 7seg
        OUTPUT sA, 00
        FETCH sA, display_bin_val_1
        FETCH sA, (sA)  ; translacja na znak 7seg
        OUTPUT sA, 01
        FETCH sA, display_bin_val_2
        FETCH sA, (sA)  ; translacja na znak 7seg
        OUTPUT sA, 02
        FETCH sA, display_bin_val_3
        FETCH sA, (sA)  ; translacja na znak 7seg
        OUTPUT sA, 03
    FETCH sB, edit_mode
    TEST sB, 01  ; C-> jestem w edit modzie
    JUMP C, now_check_if_should_blink
    RETURN
    now_check_if_should_blink:
        FETCH sB, cursor_flash_cntr_b1
        TEST sB, 01  ; C-> turn off
        JUMP C, turn_off_one_guy
        RETURN
    turn_off_one_guy:
        FETCH sA, cursor_select  ; w sA wartosc wybranego kursora (portu)
        LOAD s9, FF
        OUTPUT s9, (sA)
    RETURN

; updates buttons + debounce protection, flags when button is pressed
update_buttons_state:
    LOAD sA, debounce_cntr_0 ; adres
    LOAD sB, button_press_0  ; adres buttonpress do ustawienia
    LOAD sC, pressed_before_0 ; adres pressed before
    INPUT s9, 00 ; w s9 jest stan guzikow
    main_button_update_loop:
        LOAD s7, 00
        STORE s7, (sB) ; na dobry poczatek dnia clearowanie flagi
        OUTPUT s7, (sB) ; dane diagnostyczne
        FETCH s8, (sA)
        COMPARE s8, 00
        JUMP NZ, main_button_update_loop_decrement_ctr_continue
        TEST s9, 01 ; C -> wcisniety guzik
        JUMP NC, force_0_press_bef_then_main_button_update_loop_continue
        LOAD s7, 0F ; no ustawiamy counter
        STORE s7, (sA) 
        OUTPUT s7, (sA) ; dane diagnostyczne
        ; flage ustawiamy na podstawie pressed_before
        FETCH sD, (sC)
        TEST sD, 01 ; pressed before = 1 -> C=1 -> nie ustawiaj flagi
        JUMP C, main_button_update_loop_continue
        LOAD s7, 01  ; ustawiona flaga
        STORE s7, (sB) 
        OUTPUT s7, (sB) ; dane diagnostyczne
        JUMP main_button_update_loop_continue
        main_button_update_loop_decrement_ctr_continue:
            SUB s8, 01
            JUMP NZ, just_store_in_main_button_update_loop_decrement_ctr_continue
            LOAD sD, 01
            STORE sD, (sC)
            OUTPUT sD, (sC) ; dane diagnostyczne
        just_store_in_main_button_update_loop_decrement_ctr_continue:
            STORE s8, (sA)
            OUTPUT s8, (sA) ; dane diagnostyczne
        main_button_update_loop_continue:
            ; rotacja
            SR0 s9
            ; i++ i sprawdzenie warunku
            ADD sA, 01
            ADD sB, 01
            ADD sC, 01
            COMPARE sA, debounce_cntr_4
            JUMP NZ, main_button_update_loop
    RETURN
        force_0_press_bef_then_main_button_update_loop_continue:
            LOAD sD, 00
            STORE sD, (sC)
            OUTPUT sD, (sC) ; dane diagnostyczne
            JUMP main_button_update_loop_continue

; tests if should switch modes, sets the new state
switch_mode_test:
    ; button_i(3) - przycisk BTNL
    ; jesli debounce cntr >0 | pressed_before >0 <=> debounce cntr+ pressed_before =/= 0
    FETCH s3, debounce_cntr_3
    FETCH s4, pressed_before_3
    ADD s3, s4
    OUTPUT s3, FF  ; dane diagnostyczne (debounce_cntr_3 + pressed_before_3)
    JUMP Z, force_ctr_0_and_return
    ; teraz incrementujemy
    FETCH s8, switch_mode_cntr_b0
    FETCH s9, switch_mode_cntr_b1
    ADD s8, 01
    ADDCY s9, 00
    STORE s8, switch_mode_cntr_b0
    STORE s9, switch_mode_cntr_b1 ; ostatni zapis, teraz ifujemy
    OUTPUT s8, switch_mode_cntr_b0 ; dane diagnostyczne
    OUTPUT s9, switch_mode_cntr_b1 ; dane diagnostyczne
    TEST s9, 02  ; C=1 -> 512 ms minelo
    JUMP C, change_modes_for_real
    RETURN ; returnujemy jesli jeszcze nie zmieniamy mode'u
    change_modes_for_real:
        FETCH s3, edit_mode
        XOR s3, 01 ; flip the bit
        STORE s3, edit_mode
        OUTPUT s3, edit_mode ; dane diagnostyczne
    force_ctr_0_and_return:
        LOAD s3, 00
        STORE s3, switch_mode_cntr_b0
        STORE s3, switch_mode_cntr_b1
        OUTPUT s3, switch_mode_cntr_b0 ; dane diagnostyczne
        OUTPUT s3, switch_mode_cntr_b1 ; dane diagnostyczne
    RETURN

; initialization and endless loop
entrypoint:
    DISABLE INTERRUPT

    ; clearowanie ramu
    LOAD s0, 00 ; dane
    LOAD s1, 10 ; adres
    clear_ram_loop:
        STORE s0, (s1)
        ADD s1, 01
        COMPARE s1, 40
        JUMP NZ, clear_ram_loop

    ; budujemy tablice w scratch pad memory
    build_translation_table:
        LOAD s0, 00000011'b ; 0
        STORE s0, 00    
        LOAD s0, 10011111'b ; 1
        STORE s0, 01    
        LOAD s0, 00100101'b ; 2
        STORE s0, 02    
        LOAD s0, 00001101'b ; 3
        STORE s0, 03    
        LOAD s0, 10011001'b ; 4
        STORE s0, 04    
        LOAD s0, 01001001'b ; 5
        STORE s0, 05    
        LOAD s0, 01000001'b ; 6
        STORE s0, 06    
        LOAD s0, 00011111'b ; 7
        STORE s0, 07    
        LOAD s0, 00000001'b ; 8
        STORE s0, 08    
        LOAD s0, 00001001'b ; 9
        STORE s0, 09    
        LOAD s0, 00010001'b ; A
        STORE s0, 0A    
        LOAD s0, 11000001'b ; b
        STORE s0, 0B    
        LOAD s0, 01100011'b ; C
        STORE s0, 0C    
        LOAD s0, 10000101'b ; d
        STORE s0, 0D    
        LOAD s0, 01100001'b ; E
        STORE s0, 0E    
        LOAD s0, 01110001'b ; F
        STORE s0, 0F

    ; printuje pierwsze zera
    CALL print_to_7seg

    ; teraz wlaczam przerwania i czekam
    ENABLE INTERRUPT
    main_loop:
        JUMP main_loop

clock_interrupt:
    CALL increment_general_counter
    CALL update_buttons_state
    CALL switch_mode_test
    FETCH s8, edit_mode
    OUTPUT s8, edit_mode  ; dane diagnostyczne o stanie maszyny (edit mode czy nie)
    COMPARE s8, 01
    JUMP NZ, clear_flash_cntr_and_just_print_already
    ; najpierw increment flash cntr
    FETCH s8, cursor_flash_cntr_b0
    FETCH s9, cursor_flash_cntr_b1
    ADD s8, 01
    ADDCY s9, 00
    STORE s8, cursor_flash_cntr_b0
    STORE s9, cursor_flash_cntr_b1
    OUTPUT s8, cursor_flash_cntr_b0  ; dane diagnostyczne flash counter
    OUTPUT s9, cursor_flash_cntr_b1  ; dane diagnostyczne flash counter
    ; button_i(3) - przycisk BTNL
    ; button_i(2) - przycisk BTNR
    ; button_i(1) - przycisk BTNU
    ; button_i(0) - przycisk BTND
    LOAD sA, display_bin_val_0 ; adres modyfikowanej komureczki
    FETCH sB, cursor_select  ; sB zawiera kursorek
    ADD sA, sB
    button_actions:
        FETCH s8, button_press_0
        COMPARE s8, 01
        JUMP NZ, next_comparison1
        FETCH s8, (sA)
        SUB s8, 01
        AND s8, 0F
        STORE s8, (sA)
    next_comparison1:
        FETCH s8, button_press_1
        COMPARE s8, 01
        JUMP NZ, next_comparison2
        FETCH s8, (sA)
        ADD s8, 01
        AND s8, 0F
        STORE s8, (sA)
    next_comparison2:
        FETCH s8, button_press_2
        COMPARE s8, 01
        JUMP NZ, next_comparison3
        SUB sB, 01
        AND sB, 03
        STORE sB, cursor_select        
        OUTPUT sB, cursor_select ; dane diagnostyczne
    next_comparison3:
        FETCH s8, button_press_3
        COMPARE s8, 01
        JUMP NZ, just_print_already
        ADD sB, 01
        AND sB, 03
        STORE sB, cursor_select  
        OUTPUT sB, cursor_select ; dane diagnostyczne
    just_print_already:
        CALL print_to_7seg
    RETURNI ENABLE
    clear_flash_cntr_and_just_print_already:
        LOAD s9, 00
        STORE s9, cursor_flash_cntr_b0
        STORE s9, cursor_flash_cntr_b1
        JUMP just_print_already

; interrupt vector
ADDRESS 3FF
    JUMP clock_interrupt
    